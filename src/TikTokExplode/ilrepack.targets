<Project>
  <!--
    Merge Domain + Infrastructure into TikTokExplode.dll during publish.
    Uses ilrepack CLI (dotnet tool: dotnet-ilrepack).
    Does NOT use ILRepack.Lib.MSBuild.Task NuGet package to avoid build interference.
  -->
  <Target Name="ILRepackAfterPublishCopy" AfterTargets="CopyFilesToPublishDirectory" Condition="'$(Configuration)' == 'Release' AND '$(ILRepackDone)' != 'true'">

    <PropertyGroup>
      <ILRepackDone>true</ILRepackDone>
    </PropertyGroup>

    <!-- Merge Domain and Infrastructure into TikTokExplode.dll -->
    <Exec Command="ilrepack /parallel /internalize /xmldocs /out:&quot;$(PublishDir)TikTokExplode.dll&quot; &quot;$(OutputPath)TikTokExplode.dll&quot; &quot;$(OutputPath)TikTokExplode.Domain.dll&quot; &quot;$(OutputPath)TikTokExplode.Infrastructure.dll&quot;" />

    <!-- Remove original DLLs and related files from publish output -->
    <Delete Files="$(PublishDir)TikTokExplode.Domain.dll" Condition="Exists('$(PublishDir)TikTokExplode.Domain.dll')" />
    <Delete Files="$(PublishDir)TikTokExplode.Infrastructure.dll" Condition="Exists('$(PublishDir)TikTokExplode.Infrastructure.dll')" />
    <Delete Files="$(PublishDir)TikTokExplode.Domain.pdb" Condition="Exists('$(PublishDir)TikTokExplode.Domain.pdb')" />
    <Delete Files="$(PublishDir)TikTokExplode.Infrastructure.pdb" Condition="Exists('$(PublishDir)TikTokExplode.Infrastructure.pdb')" />
    <Delete Files="$(PublishDir)TikTokExplode.Domain.xml" Condition="Exists('$(PublishDir)TikTokExplode.Domain.xml')" />
    <Delete Files="$(PublishDir)TikTokExplode.Infrastructure.xml" Condition="Exists('$(PublishDir)TikTokExplode.Infrastructure.xml')" />
  </Target>
</Project>
